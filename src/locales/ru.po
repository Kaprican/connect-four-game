#: src/components/start-modal/start-modal.tsx:19
msgid "Close the rules"
msgstr "Скрыть правила"

#: src/components/result-modal/result-modal.tsx:14
msgid "Congrats!"
msgstr "Поздравляем!"

#: src/App.tsx:109
msgid "Connect Four"
msgstr "4 в ряд"

#: src/components/start-modal/start-modal.tsx:19
msgid "Game rules here"
msgstr "Правила игры тут"

#: src/components/start-modal/start-modal.tsx:14
msgid "Hi, pal"
msgstr "Привет, друг"

#: src/components/start-modal/start-modal.tsx:42
msgid "If you're ready, so, grab your lad and have a nice time together"
msgstr "Если готов начать, то хватай приятеля и приятной игры"

#: src/components/start-modal/start-modal.tsx:28
msgid "Players drop the discs into the grid, starting in the middle or at the edge to stack their colored discs"
msgstr "Игроки бросают диски на поле, начиная с середины или с края, чтобы сложить цветные диски в колонку"

#: src/components/settings-modal/settings-modal.tsx:41
msgid "Restart game"
msgstr "Переиграть"

#: src/components/settings-modal/settings-modal.tsx:35
msgid "Settings"
msgstr "Настройки"

#: src/components/result-modal/result-modal.tsx:14
msgid "So..."
msgstr "Пу-пу-пу"

#: src/components/settings-modal/settings-modal.tsx:44
msgid "Sound"
msgstr "Звуки"

#: src/components/start-modal/start-modal.tsx:45
msgid "Start"
msgstr "Start"

#: src/components/result-modal/result-modal.tsx:25
msgid "Start new game"
msgstr "Начать новую игру"

#: src/components/start-modal/start-modal.tsx:15
msgid "This is a connect four game"
msgstr "Это игра 4 в ряд"

#: src/components/start-modal/start-modal.tsx:33
msgid "Use strategy to block opponents while aiming to be the first player to get 4 in a row to win."
msgstr "Используй стратегию, котроая позволит блокировать соперника и при этом собирать свою линию для победы"

#: src/components/start-modal/start-modal.tsx:31
msgid "When a player drops a disc, it falls to the lowest available space in that column"
msgstr "Когда игрок бросает диск, он падает на нижнюю незанятую позицию в выбранном столбце"

#: src/components/start-modal/start-modal.tsx:24
msgid "You have 7x6 grid"
msgstr "У вас есть поле 7x6"

#: src/components/start-modal/start-modal.tsx:25
msgid "Your goal to get four of their discs in a row — horizontally, vertically, or diagonally"
msgstr "Ваша цель — собрать линию из 4 дисков вашего цвета по горизонтали, вертикали или диагонали"
